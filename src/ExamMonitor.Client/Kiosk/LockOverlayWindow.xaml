<Window x:Class="ExamMonitor.Client.Kiosk.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Screen Locked"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F2090D16"
        Foreground="#F8FAFC">
    <Grid>
        <Border Background="#1E293B"
                BorderBrush="#EA580C"
                BorderThickness="2"
                CornerRadius="12"
                Padding="40,32"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="EXAM TERMINAL LOCKED"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FB923C"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="LockReasonTextBlock"
                           Text="Your screen has been locked by the exam proctor. Please remain seated and wait for instructions."
                           FontSize="15"
                           Foreground="#E2E8F0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
