<!-- c:\Users\ivand\Documents\Coding\Project\U-Monitor\src\ExamMonitor.Client\Kiosk\MainWindow.xaml -->
<Window x:Class="ExamMonitor.Client.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="U-Monitor"
        Width="760"
        Height="470"
        MinWidth="680"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Foreground="#1F2937"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANE: RustDesk "Your Desktop" Sidebar -->
        <Border Grid.Row="0" Grid.Column="0" Background="#F5F6F8" Padding="20,22,20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Your Desktop"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Your desktop is shared on LAN with this ID and identity."
                               FontSize="11.5"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               Margin="0,4,0,18" />

                    <TextBlock Text="ID"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <Border Background="#FFFFFF"
                            BorderBrush="#E4E7ED"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,4,0,14">
                        <StackPanel>
                            <TextBlock x:Name="WorkstationIdTextBlock"
                                       Text="PC-01"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Segoe UI"
                                       Foreground="#111827" />
                            <TextBlock x:Name="WorkstationInfoTextBlock"
                                       Text="Windows"
                                       FontSize="10.5"
                                       Foreground="#9CA3AF"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Student ID (NIM)"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="StudentIdTextBox"
                             Style="{StaticResource RdTextBox}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Student Name"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="StudentNameTextBox"
                             Style="{StaticResource RdTextBox}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Hide to Taskbar"
                            Style="{StaticResource RdSecondaryButton}"
                            Click="OnMinimizeToBackgroundClicked"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6" />
                    <Button Content="Disconnect &amp; Quit"
                            Style="{StaticResource RdSecondaryButton}"
                            Click="OnExitExamClicked"
                            Foreground="#DC2626"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vertical 1px Divider -->
        <Border Grid.Row="0" Grid.Column="1" Background="#E4E7ED" />

        <!-- RIGHT PANE: RustDesk "Connect to Server" & Peer Session Panel -->
        <Grid Grid.Row="0" Grid.Column="2" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Connect Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Connect to Classroom Server"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="Auto-discovers on UDP 45454 or enter the Proctor Server IP address manually"
                           FontSize="11.5"
                           Foreground="#6B7280"
                           Margin="0,3,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ServerIpTextBox"
                             Grid.Column="0"
                             Text="127.0.0.1"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Padding="10,7"
                             Style="{StaticResource RdTextBox}" />

                    <TextBox x:Name="ServerPortTextBox"
                             Grid.Column="2"
                             Text="45455"
                             FontSize="13"
                             Padding="8,7"
                             TextAlignment="Center"
                             Style="{StaticResource RdTextBox}" />

                    <Button x:Name="ConnectButton"
                            Grid.Column="4"
                            Content="Connect"
                            Click="OnConnectClicked"
                            Style="{StaticResource RdPrimaryButton}" />
                </Grid>
            </StackPanel>

            <!-- Broadcast Alert Strip (Only visible when proctor sends message) -->
            <Border x:Name="BroadcastBanner"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#EFF6FF"
                    BorderBrush="#93C5FD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BroadcastMessageTextBlock"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E40AF"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Dismiss"
                            Click="OnDismissBroadcastClicked"
                            Style="{StaticResource RdSecondaryButton}"
                            Padding="8,3"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- RustDesk Style Section Tab Header -->
            <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="#0071FF" BorderThickness="0,0,0,2" Padding="2,0,2,7" Margin="0,0,20,0">
                        <TextBlock Text="Active Session"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#0071FF" />
                    </Border>
                    <Border Padding="2,0,2,7">
                        <TextBlock Text="LAN Discovery (UDP 45454)"
                                   FontSize="12.5"
                                   Foreground="#6B7280" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Session & Screen Share Telemetry Card -->
            <Border Grid.Row="3"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Proctor Server Session"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="ConnectionStatusTextBlock"
                                       Text="Searching for Proctor Server on local network..."
                                       FontSize="11.5"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Background="#EEF2FF"
                                BorderBrush="#C7D2FE"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="ConnectionBadgeTextBlock"
                                       Text="STANDBY"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#0071FF" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#E5E7EB" Height="1" Margin="0,2,0,10" />

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Active Foreground Window"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280" />
                        <TextBlock x:Name="ActiveWindowTextBlock"
                                   Text="[Desktop] Ready"
                                   FontSize="12"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#111827"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM BAR: Authentic RustDesk Status Strip -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#F9FAFB"
                BorderBrush="#E4E7ED"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="8"
                         Height="8"
                         Fill="#F59E0B"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock x:Name="FooterStatusTextBlock"
                           Grid.Column="1"
                           Text="Ready — Listening for LAN Server on UDP :45454"
                           FontSize="11.5"
                           Foreground="#4B5563"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="U-Monitor v1.0 (LAN Direct)"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
