<Window x:Class="ExamMonitor.Server.Views.StudentDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Student.MachineName, Mode=OneWay}"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp"
        Background="#000000"
        Foreground="#F9FAFB"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- RustDesk Top Remote Session Toolbar -->
        <Border Grid.Row="0" Background="#1F2329" BorderBrush="#2E343D" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Connected Peer Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center">
                        <Run Text="{Binding Student.MachineName, Mode=OneWay}" />
                        <Run Text=" — " Foreground="#9CA3AF" />
                        <Run Text="{Binding Student.StudentName, Mode=OneWay}" />
                        <Run Text=" (" Foreground="#9CA3AF" /><Run Text="{Binding Student.IpAddress, Mode=OneWay}" Foreground="#9CA3AF" /><Run Text=")" Foreground="#9CA3AF" />
                    </TextBlock>
                    <Border Background="#2D333B" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Student.ResolutionText, Mode=OneWay}"
                                   FontSize="10.5"
                                   FontFamily="Consolas, Segoe UI"
                                   Foreground="#D1D5DB" />
                    </Border>
                </StackPanel>

                <!-- Center: Direct Message Quick Input -->
                <Grid Grid.Column="1" MaxWidth="320" Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectMessageTextBox"
                             Grid.Column="0"
                             Text="{Binding DirectMessage, UpdateSourceTrigger=PropertyChanged}"
                             Background="#111418"
                             Foreground="#F9FAFB"
                             BorderBrush="#374151"
                             FontSize="11.5"
                             Padding="7,3"
                             Style="{StaticResource RdTextBox}" />
                    <Button Grid.Column="2"
                            Content="Send Msg"
                            Command="{Binding SendDirectMessageCommand}"
                            Style="{StaticResource RdPrimaryButton}"
                            FontSize="11"
                            Padding="10,4" />
                </Grid>

                <!-- Right: Session Control Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Control Mouse &amp; Keyboard"
                              IsChecked="{Binding IsRemoteControlEnabled, Mode=TwoWay}"
                              Foreground="#E5E7EB"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <Button Content="Screenshot"
                            Click="OnSaveScreenshotClicked"
                            Style="{StaticResource RdSecondaryButton}"
                            FontSize="11"
                            Padding="9,4"
                            Margin="0,0,6,0" />
                    <Button Content="Lock"
                            Command="{Binding LockStudentCommand}"
                            Style="{StaticResource RdSecondaryButton}"
                            FontSize="11"
                            Padding="9,4"
                            Margin="0,0,6,0" />
                    <Button Content="Unlock"
                            Command="{Binding UnlockStudentCommand}"
                            Style="{StaticResource RdSecondaryButton}"
                            FontSize="11"
                            Padding="9,4"
                            Margin="0,0,6,0" />
                    <Button Content="Disconnect"
                            Click="OnCloseClicked"
                            Style="{StaticResource RdDangerButton}"
                            FontSize="11"
                            Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edge-to-Edge Remote Desktop Canvas -->
        <Grid Grid.Row="1" Background="#000000">
            <Image x:Name="RemoteDesktopImage"
                   Source="{Binding Student.ThumbnailFrame, Mode=OneWay}"
                   Stretch="Uniform"
                   Cursor="Arrow"
                   MouseMove="OnRemoteImageMouseMove"
                   MouseDown="OnRemoteImageMouseDown"
                   MouseUp="OnRemoteImageMouseUp"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
    </Grid>
</Window>
